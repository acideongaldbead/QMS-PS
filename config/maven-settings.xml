<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for this machine.
  Central is reached through the Aliyun public mirror: on this network GitHub
  release assets stall and upstream repositories are slow, while domestic
  mirrors answer immediately. Remove the <mirrors> block if the build ever needs
  to run on a network that blocks the mirror.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun public repository mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>

</settings>
