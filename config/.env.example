# QMS development configuration.
#
# Copy to config\.env and fill in real values. NEVER commit .env (it is
# gitignored). scripts\env.ps1 and scripts\qms-server.ps1 load this file into
# the process environment before starting the jar.
#
# PRODUCTION DOES NOT USE THIS FILE. A deployed install is configured by
# deploy\templates\application-prod.yml.template, rendered to
# <install>\config\application-prod.yml (see deploy\docs). Do not copy this
# file to a server: several of its defaults are development values.

# --- PostgreSQL ---
# NOTE: match the port your PostgreSQL server actually listens on.
# The local dev install listens on 5433, not the default 5432.
QMS_DB_URL=jdbc:postgresql://localhost:5433/qms
QMS_DB_USER=postgres
QMS_DB_PASSWORD=change-me

# --- JWT ---
# Mandatory: the jar ships no default, so a start without this fails loudly
# rather than signing tokens with a well-known secret. At least 32 bytes.
QMS_JWT_SECRET=change-me-to-a-long-random-string-0123456789abcdef
# Seeds the nine dummy accounts (application-local.yml). Absent in production.
QMS_DEV_PASSWORD=Qms@2026

# --- D8 report mail (requirement 3.9) ---
# provider=noop records the send in the communication log without a relay;
# provider=smtp really sends. The variable names must match application-local.yml
# (qms.smtp.* -> spring.mail.*), so use QMS_SMTP_*, not SPRING_MAIL_*.
QMS_MAIL_PROVIDER=noop
QMS_MAIL_FROM=qms@local
QMS_SMTP_HOST=localhost
QMS_SMTP_PORT=1025
QMS_SMTP_USER=
QMS_SMTP_PASSWORD=

# --- Attachment storage ---
# scripts\qms-server.ps1 rewrites this to an absolute path under the repo.
QMS_STORAGE_ROOT=./data/attachments

# --- 8D report PDF (the read-only copy) ---
# The PDF embeds a Chinese font, because PDF's built-in fonts cannot draw it.
# Leave empty to use the Windows simplified-Chinese fonts (simhei/msyh/deng);
# set a path to a single .ttf to pick a specific one.
QMS_REPORT_PDF_FONT=
